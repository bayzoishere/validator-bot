# ============================================================
# Mine Validator - Environment Variables
# ============================================================

# Required: Private key of your validator wallet
VALIDATOR_PRIVATE_KEY="0xYOUR_PRIVATE_KEY_HERE"

# Optional: Timeout settings
EVAL_TIMEOUT_SECONDS=240

# Optional: Platform API URL (defaults to https://api.minework.net)
PLATFORM_BASE_URL=https://api.minework.net

# Optional: Validator ID (defaults to validator-agent)
# VALIDATOR_ID=my-custom-validator-id

# ============================================================
# NOTES:
# - VALIDATOR_PRIVATE_KEY is required
# - Never commit this file to git!
# - Your wallet must already be registered on AWP
# - Run 'awp-wallet import --mnemonic "your seed phrase"' to get your private key
# ============================================================
